# 复制本文件为 .env 后按需修改：cp .env.example .env
# 所有变量都有默认值，不创建 .env 也能直接 docker compose up

# 端口映射
WEB_PORT=80
WEB_API_PORT=8080

# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=cipherlens

# JWT / Token 签名密钥（生产务必改成随机长字符串）
TOKEN_SECRET_KEY=change-me-in-production

# Redis（默认无密码）
REDIS_PASSWORD=

# 华为云 KMS 凭据（使用解密类功能时必填，否则留空）
HUAWEI_AK=
HUAWEI_SK=

# 前端构建用的 npm 镜像（国内可改为 https://registry.npmmirror.com）
NPM_REGISTRY=https://registry.npmjs.org
