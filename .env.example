# 复制本文件为 .env 后按需修改：cp .env.example .env
# 标【必填】的变量留空时 docker compose 会直接报错退出，不会用弱默认值启动

# 端口映射
WEB_PORT=80
WEB_API_PORT=8080

# 【必填】MySQL root 密码（随机强密码）
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=cipherlens

# 【必填】Token 签名密钥，至少 16 位随机字符串
# 生成方式：openssl rand -base64 32
TOKEN_SECRET_KEY=

# Redis（默认无密码）
REDIS_PASSWORD=

# 华为云 KMS：使用“查看密码明文/新增密码条目”等解密类功能时必填
HUAWEI_AK=
HUAWEI_SK=
# KMS 密钥 ID 与区域（密钥 ID 非敏感；与下面的 RSA 公钥为同一密钥对）
HUAWEI_KMS_KEY_ID=fe7c0e06-381f-4d29-be61-f161e2d67225
HUAWEI_KMS_REGION=cn-south-1

# 用户 AES 密钥的加密公钥（RSA-4096，公钥非敏感），一般无需修改
RSA_PUBLIC_KEY=''

# 邮件服务（找回密码验证码）：留空则该功能不可用
# 465 端口使用 SSL；若用 587 请改 MAIL_SSL_ENABLED=false 并配置 starttls
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SSL_ENABLED=true
# 仅本地/测试环境可设 true，把验证码打印到后端日志（生产务必 false）
RESET_CODE_LOG_ENABLED=false

# 前端构建用的 npm 镜像（国内可改为 https://registry.npmmirror.com）
NPM_REGISTRY=https://registry.npmjs.org
